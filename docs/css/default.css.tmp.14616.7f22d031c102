:root{--background:#d3d2ce;--text:#444136;--title:#2c633f;--heading:#645826;--subheading:#3c5a89;--link:#2c633f;--link-hover:#1b4229;--nav:#784872;--line:#834742;--ipa:#8a877f}html{font-size:72.5%;background:var(--background)}body{font-family:monospace,monospace;font-size:1.6rem;line-height:1.5;color:var(--text);background:var(--background);max-width:80rem;margin:0 auto;padding:0 1.6rem}main a{color:var(--link)}main a:hover{color:var(--link-hover)}header{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:0.8rem 2rem;padding:1.2rem 0;margin-bottom:3rem;border-bottom:0.2rem solid var(--line)}.logo a{font-size:1.8rem;font-weight:bold;color:var(--subheading);text-decoration:none}.logo .ipa{font-size:1.3rem;color:var(--ipa);margin-left:0.6rem;white-space:nowrap}nav a{font-size:1.8rem;font-weight:bold;text-transform:uppercase;color:var(--nav);text-decoration:none;margin-left:1.2rem}nav a:first-child{margin-left:0}nav a:hover,.logo a:hover{text-decoration:underline}h1{font-size:2.8rem;color:var(--title)}h2{font-size:2.4rem;color:var(--heading)}h3{font-size:2rem;color:var(--subheading)}footer{margin-top:3rem;padding:1.2rem 0 3rem;border-top:0.2rem solid var(--line);font-size:1.2rem;color:var(--heading);text-align:right}footer a{color:var(--subheading)}img{max-width:100%}figure{margin:3rem 0 0}figure img{display:block;width:36rem;border:0.2rem solid var(--line)}figcaption{margin-top:0.6rem;font-size:1.2rem;color:var(--ipa)}figcaption a{color:var(--ipa)}