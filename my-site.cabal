cabal-version:      2.4
name:               my-site
version:            0.1.0.0
build-type:         Simple

-- This describes one program, called "site", built from site.hs.
-- It is the program that turns your Markdown pages into a website.
executable site
  main-is:          site.hs
  build-depends:    base   >= 4 && < 5
                  , hakyll >= 4.16
                  , pandoc
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010
